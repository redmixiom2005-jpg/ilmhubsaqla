# =================================================================
# ILMHUB SAQLA BOT — ENVIRONMENT CONFIGURATION
# =================================================================

# --- FRONTEND CONFIGURATION ---
# The URL of your persistent downloader backend (e.g. VPS, Railway, Render, Fly.io)
# Local development with the combined server:
VITE_API_URL=""
# Vercel production frontend: set this to the public Railway URL before building:
# VITE_API_URL="https://your-railway-service.up.railway.app"

# --- BACKEND SERVER CONFIGURATION ---
# Port for the Node.js Express downloader backend
PORT=8080
NODE_ENV=production

# CORS allowed frontend origin. Use the exact Vercel production URL.
# Multiple origins (including a Vercel preview URL) can be comma-separated.
FRONTEND_URL="https://your-project.vercel.app"

# Local directory where downloaded video files are stored temporarily
# Production always uses /tmp/ilmhub-saqla; this is only for local development.
DOWNLOAD_DIR="./downloads"

# Maximum number of simultaneous downloads processed at once (others are queued)
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT_MS=1800000

# Time in hours after which downloaded temp files are automatically deleted
DOWNLOAD_RETENTION_HOURS=24

# Optional custom paths to binaries if not found in system PATH
# Optional local overrides. Containers use yt-dlp and ffmpeg from PATH.
YTDLP_PATH=""
FFMPEG_PATH=""

# GEMINI_API_KEY: Required for Gemini AI API calls if enabled
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""
